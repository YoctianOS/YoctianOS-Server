#!/bin/sh /etc/rc.common

START=99
STOP=10

SCRIPT="/usr/bin/yoctianos-server.sh"
SESSION="yoctianos-server"
PIDFILE="/var/run/yoctianos-server.pid"

start() {
    echo "Running yoctianos-server..."
    if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
        echo "yoctianos-server already running, skipping start."
        return 0
    fi

    if [ -x "$SCRIPT" ]; then
        "$SCRIPT" &
        echo $! > "$PIDFILE"
    else
        echo "Error: $SCRIPT not found or not executable"
    fi
}

stop() {
    echo "Stopping yoctianos-server..."
    screen -S "$SESSION" -X quit 2>/dev/null

    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        if kill -0 "$PID" 2>/dev/null; then
            kill "$PID"
        fi
        rm -f "$PIDFILE"
    fi
}
